# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Auth — must be at least 32 characters in production (the server refuses to start otherwise).
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret

# Server
PORT=5000
NODE_ENV=development

# Email (SMTP) — leave blank to use console.log in development
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=DOJCD Connect <noreply@dojcd.gov.za>

# Frontend URL used in password-reset emails
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# Supabase (optional — only if using cloud storage)
SUPABASE_BUCKET=
SUPABASE_SERVICE_KEY=

# Signed document links (/api/files) — links are HMAC-signed and expire.
# FILE_URL_SECRET falls back to JWT_SECRET when blank; set it to keep the two keys independent.
FILE_URL_SECRET=
FILE_URL_TTL_SECONDS=900

# Where uploaded files are stored (defaults to src/uploads). Keep this OUTSIDE the code directory in production.
UPLOADS_DIR=

# ── Sign-in: local passwords, on-premises Active Directory, or Microsoft Entra ID ──────────────────
# Full guide: docs/directory-sign-in.md
#   local  email + password stored in this database (default)
#   ldap   on-premises Active Directory: people type their domain credentials, checked over LDAPS
#   entra  Microsoft Entra ID (Azure AD): "Sign in with Microsoft"
# With ldap or entra nobody registers: an account is created automatically the first time someone signs in.
AUTH_PROVIDER=local

# Role groups (ldap and entra). A person in one of these gets that role; the strongest wins.
# Names (comma-separated) or full DNs (separate DNs with ;). Entra: object id or display name.
AD_GROUP_ADMIN=
AD_GROUP_FINANCE=
AD_GROUP_MANAGER=
AD_GROUP_APPROVER=
AD_GROUP_MTN_STAFF=
AD_GROUP_SUPER_ADMIN=
# Optional: members are Magistrates (everyone else is DIRECTORY_DEFAULT_USER_TYPE) ...
AD_GROUP_MAGISTRATES=
DIRECTORY_DEFAULT_USER_TYPE=Advocate
# ... and optionally limit who may use the client portal (empty = every directory user).
AD_GROUP_CLIENTS=

# Keep a local Admin (npm run create-admin, with AUTH_PROVIDER=local) able to sign in when the directory is down.
AUTH_ALLOW_LOCAL_ADMIN_LOGIN=false
# Failed sign-ins per username + IP before a pause (protects the domain's lockout policy).
AUTH_MAX_FAILED_LOGINS=8
AUTH_FAILED_LOGIN_WINDOW_MINUTES=10

# ── ldap: on-premises Active Directory ──
LDAP_URL=ldaps://dc01.example.local:636
# Read-only service account used to find people and read their groups:
LDAP_BIND_DN=CN=svc-dojcd,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=local
# Optional: where groups live (defaults to LDAP_BASE_DN), your CA certificate if it is not publicly trusted,
# and the attribute that holds the PERSAL number.
LDAP_GROUP_BASE_DN=
LDAP_CA_FILE=
LDAP_ATTR_PERSAL=employeeID
# Only for ldap:// (not recommended): LDAP_STARTTLS=true, or LDAP_ALLOW_INSECURE=true in a lab.
LDAP_STARTTLS=false
LDAP_ALLOW_INSECURE=false

# ── entra: Microsoft Entra ID ──
# Must be the tenant GUID. Register the app with this redirect URI: ENTRA_REDIRECT_URI (below).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# The API's callback, exactly as registered in Entra ID, e.g. https://api.example.gov.za/api/auth/entra/callback
ENTRA_REDIRECT_URI=
# Front-end pages people may be sent back to after signing in (exact addresses, comma-separated):
AUTH_ALLOWED_REDIRECTS=https://admin.example.gov.za/auth/callback,https://client.example.gov.za/auth/callback
